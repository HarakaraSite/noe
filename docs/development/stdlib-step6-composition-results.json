      "// Inspect workspace files and noe:http docs\nconst {docs} = await import(\"noe:docs\");\nconsole.log(docs(\"noe:http\"));\nconst fs = await import(\"node:fs\");\nconsole.log(\"cwd:\", process.cwd());\nconsole.log(fs.readdirSync(\".\").join(\"\\n\"));\ntry { console.log(\"INPUT:\", fs.readFileSync(\"input.json\",\"utf8\")); } catch(e) { console.log(\"no input.json:\", e.message); }\n",
      "// Check serve and fetch member docs\nconst {docs} = await import(\"noe:docs\");\nconsole.log(docs(\"noe:http\",\"serve\"));\nconsole.log(\"-----\");\nconsole.log(docs(\"noe:http\",\"fetch\"));\n",
      "// Sum amounts from input.json, serve JSON on loopback, fetch-verify, and write report.json\nconst { fetch, serve } = await import(\"noe:http\");\nconst fs = await import(\"node:fs\");\n\nconst rows = JSON.parse(fs.readFileSync(\"input.json\", \"utf8\"));\nconst rowCount = rows.length;\nconst total = rows.reduce((sum, row) => sum + row.amount, 0);\nconst payload = { rowCount, total };\n\nconst server = serve({ hostname: \"127.0.0.1\", port: 0 }, async (request) => {\n  return Response.json(payload);\n});\n\nlet verified = false;\ntry {\n  console.log(\"listening on\", server.url);\n  const response = await fetch(server.url);\n  if (!response.ok) throw new Error(\"HTTP \" + response.status);\n  const data = await response.json();\n  const bodyOk = data.rowCount === rowCount && data.total === total;\n  const expectOk = data.rowCount === 3 && data.total === 31;\n  verified = bodyOk && expectOk;\n  if (!verified) throw new Error(\"verification failed: \" + JSON.stringify(data));\n  fs.writeFileSync(\"report.json\", JSON.stringify(data, null, 2) + \"\\n\", \"utf8\");\n  console.log(\"response:\", JSON.stringify(data));\n} finally {\n  server.close();\n}\n\nconst saved = JSON.parse(fs.readFileSync(\"report.json\", \"utf8\"));\nconsole.log(\"verified:\", verified);\nconsole.log(\"report.json:\", JSON.stringify(saved));\n"
