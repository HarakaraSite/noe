{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"linter": {
		"rules": {
			"recommended": false,
			"correctness": {
				"noConstAssign": "error",
				"noUndeclaredVariables": "error",
				"noUnreachable": "error"
			},
			"suspicious": {
				"noDuplicateObjectKeys": "error",
				"noDuplicateParameters": "error",
				"noRedeclare": "error"
			}
		}
	},
	"javascript": {
		"globals": [
			"serve",
			"upgradeWebSocket",
			"ShadowRealm",
			"Temporal",
			"AsyncDisposableStack",
			"DisposableStack",
			"Float16Array",
			"SuppressedError"
		]
	}
}
